# ── Langfuse (self-hosted, already running in Docker) ──────────────────────
# Get keys from the Langfuse UI: Settings → API Keys → Create.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000     # NOTE: BASE_URL, not BASEURL

# ── LLM provider (OpenAI-compatible; swap models freely to compare cost) ───
# Point at your OpenAI-compatible gateway. Any provider works as long as it
# speaks the OpenAI chat-completions API.
LLM_BASE_URL=http://localhost:4096/v1       # e.g. your opencode gateway / OpenAI / Groq / OpenRouter / Ollama
LLM_API_KEY=sk-...                          # use any non-empty string if your gateway ignores it
LLM_MODEL=gpt-4o-mini                       # main model: write / repair / answer
LLM_JUDGE_MODEL=gpt-4o-mini                 # cheaper model: judges / evals

# Optional: a second "candidate" model used by the v2 experiment, so you can
# compare cost/quality of two models on the golden set. Defaults to LLM_MODEL.
LLM_MODEL_V2=gpt-4o-mini

# Optional: token pricing (USD per 1,000,000 tokens) so the web UI's Cost tile
# shows a value. This is only for the app's own estimate — Langfuse computes its
# own cost from the model definition you add in Settings → Models. Leave unset to
# show "—" instead of a guessed number.
LLM_PRICE_IN=                               # e.g. 0.30  (input $/1M tokens)
LLM_PRICE_OUT=                              # e.g. 1.20  (output $/1M tokens)
